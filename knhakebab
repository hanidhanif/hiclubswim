css = r''':root{
  --maroon:#711f2a;--maroon-dark:#4e151d;--cream:#f5efe3;--paper:#fffaf2;
  --gray:#686762;--dark:#20201f;--line:rgba(32,32,31,.12);--shadow:0 24px 70px rgba(72,30,30,.12);
}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:"DM Sans",sans-serif;background:var(--cream);color:var(--dark);line-height:1.6}
a{text-decoration:none;color:inherit}.navbar{height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 7vw;background:rgba(245,239,227,.9);backdrop-filter:blur(14px);position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line)}
.logo{font-weight:700;font-size:20px;letter-spacing:-.6px}.logo span{color:var(--maroon)}
nav{display:flex;gap:34px;margin-left:70px}nav a{font-size:13px;font-weight:600;color:#777;transition:.2s}nav a:hover{color:var(--maroon)}
.nav-cta{font-size:13px;font-weight:700;background:var(--maroon);color:#fff;padding:12px 18px;border-radius:100px}.nav-cta span,.btn span{margin-left:8px}
.menu-toggle{display:none;border:0;background:none;font-size:24px}
.hero{min-height:calc(100vh - 82px);display:grid;grid-template-columns:1.05fr .95fr;align-items:center;padding:70px 7vw 85px;overflow:hidden}
.eyebrow{font-size:10px;letter-spacing:2.7px;font-weight:800;color:var(--maroon);margin-bottom:16px}
h1,h2{font-family:"Playfair Display",serif;line-height:1.04;letter-spacing:-1.8px}h1{font-size:clamp(48px,6.3vw,88px)}h2{font-size:clamp(40px,4.8vw,64px)}h1 em,h2 em{font-style:italic;color:var(--maroon)}
.hero-text{max-width:520px;color:var(--gray);font-size:15px;margin:25px 0 30px}.hero-actions{display:flex;align-items:center;gap:28px}
.btn{display:inline-flex;align-items:center;padding:14px 21px;border-radius:100px;font-size:13px;font-weight:800}.btn-primary{background:var(--maroon);color:#fff;box-shadow:0 10px 25px rgba(113,31,42,.2)}.btn-dark{background:var(--dark);color:#fff}.btn-light{background:var(--paper);color:var(--maroon)}
.text-link{font-size:13px;font-weight:800;border-bottom:1px solid var(--dark);padding-bottom:3px}
.mini-stats{display:flex;gap:32px;margin-top:60px}.mini-stats div{display:flex;flex-direction:column}.mini-stats strong{font-size:16px}.mini-stats span{font-size:10px;color:#85827b;text-transform:uppercase;letter-spacing:1px}
.hero-visual{min-height:590px;position:relative;display:grid;place-items:center}.circle{position:absolute;border-radius:50%}.circle-one{width:500px;height:500px;background:#e8d8c3}.circle-two{width:390px;height:390px;border:1px solid rgba(113,31,42,.18)}
.food-card{position:relative;width:min(390px,70vw);padding:22px;background:rgba(255,250,242,.65);border:1px solid rgba(255,255,255,.8);border-radius:28px;box-shadow:var(--shadow);transform:rotate(2deg)}
.food-illustration{height:390px;border-radius:20px;background:linear-gradient(145deg,#eee2d0,#d6b99c);position:relative;overflow:hidden}
.plate{position:absolute;width:270px;height:85px;background:#f7f2e9;border-radius:50%;bottom:72px;left:50%;transform:translateX(-50%);box-shadow:0 15px 20px #5c443322}
.kebab-wrap{position:absolute;left:50%;bottom:76px;transform:translateX(-50%) rotate(-7deg);width:160px;height:260px;filter:drop-shadow(0 18px 14px #5a281d33)}
.wrap-top{position:absolute;inset:0 0 auto;height:220px;background:#d9ae79;clip-path:polygon(10% 0,90% 0,100% 100%,50% 88%,0 100%);border-radius:25px}
.meat{position:absolute;width:110px;height:25px;background:#7a3525;border-radius:50%;left:25px}.meat-a{top:95px}.meat-b{top:125px;background:#633022}
.veg{position:absolute;top:155px;left:27px;width:108px;height:35px;background:#718144;border-radius:45% 45% 35% 35%}.sauce{position:absolute;top:170px;left:35px;width:90px;height:17px;background:#f4dfba;border-radius:20px}.wrap-bottom{position:absolute;bottom:0;left:25px;width:110px;height:55px;background:#e1bd8e;clip-path:polygon(0 0,100% 0,82% 100%,18% 100%)}
.leaf{position:absolute;color:#fff8ec;font-size:25px}.leaf-one{top:35px;right:45px}.leaf-two{bottom:45px;left:35px}
.food-label{display:flex;flex-direction:column;padding:17px 4px 2px}.food-label span{font-size:9px;color:var(--maroon);letter-spacing:2px;font-weight:800}.food-label strong{font-family:"Playfair Display";font-size:21px}
.floating-badge{position:absolute;right:3%;bottom:90px;background:var(--maroon);color:#fff;padding:18px 22px;border-radius:50%;width:120px;height:120px;display:grid;place-content:center;text-align:center;font-size:10px;line-height:1.35;box-shadow:0 15px 30px #4e151d33;transform:rotate(-8deg)}.floating-badge span{font-size:17px}
.menu-section{padding:105px 7vw;background:var(--paper)}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:45px}.section-note{text-align:right;color:var(--gray);font-size:13px}.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.menu-card{background:#f6f0e5;border-radius:22px;overflow:hidden;transition:.3s}.menu-card:hover{transform:translateY(-7px);box-shadow:var(--shadow)}.menu-art{height:245px;display:grid;place-items:center;font-size:105px;background:#eadfcd}.art-doner{background:#ddd5c9}.art-fries{background:#ead6c0}.card-info{padding:22px}.tag{font-size:9px;letter-spacing:2px;font-weight:800;color:var(--maroon)}.card-info h3{font-family:"Playfair Display";font-size:25px;margin:5px 0}.card-info p{font-size:12px;color:var(--gray);margin-bottom:14px}.card-info strong{font-size:14px;color:var(--maroon)}
.story{display:grid;grid-template-columns:.9fr 1.1fr;gap:9vw;align-items:center;padding:120px 7vw}.story-visual{height:430px;border-radius:30px;background:#ddd0bd;position:relative;display:grid;place-items:center;overflow:hidden}.story-orbit{width:300px;height:300px;border:1px solid rgba(113,31,42,.3);border-radius:50%;transform:rotate(25deg)}.story-icon{position:absolute;font-size:100px;color:var(--maroon);font-family:serif}.story-stamp{position:absolute;bottom:25px;left:25px;background:var(--paper);padding:14px 18px;font-size:9px;letter-spacing:2px;font-weight:800;color:var(--maroon)}.story-copy>p:not(.eyebrow){max-width:530px;color:var(--gray);font-size:14px;margin:25px 0 30px}
.cta{margin:0 7vw 80px;padding:65px 7%;background:var(--maroon);color:#fff;border-radius:30px;display:flex;justify-content:space-between;align-items:center}.cta .eyebrow{color:#e9c9b9}.cta h2 em{color:#f0d1bf}
footer{padding:35px 7vw 45px;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center}footer p{text-align:center;color:#888;font-size:12px}footer small{text-align:right;color:#999;font-size:10px}
@media(max-width:800px){nav,.nav-cta{display:none}.menu-toggle{display:block}.navbar{padding:0 5vw}.hero{grid-template-columns:1fr;padding:55px 5vw}.hero-visual{min-height:470px}.circle-one{width:390px;height:390px}.circle-two{width:310px;height:310px}.food-card{width:330px}.food-illustration{height:330px}.mini-stats{margin-top:40px;gap:18px}.section-head{display:block}.section-note{text-align:left;margin-top:18px}.menu-grid{grid-template-columns:1fr}.story{grid-template-columns:1fr;padding:80px 5vw}.cta{margin:0 5vw 55px;display:block}.cta .btn{margin-top:28px}footer{grid-template-columns:1fr;gap:12px;text-align:center}footer p,footer small{text-align:center}}
'''

